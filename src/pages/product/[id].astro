---
export const prerender = false;

import LayoutPublico from '../../layouts/LayoutPublico.astro';
import { createServerSupabase, getImageUrl } from '../../lib/supabaseServer';
import '../../styles/globals.css';

const { id } = Astro.params;
if (!id) return Astro.redirect('/');

const supabase = createServerSupabase();
const { data: product } = await supabase
  .from('products')
  .select(`
    *,
    category:categories(id, name, slug),
    brand:brands(id, name, slug),
    images:product_images(storage_path, alt_text, is_primary, display_order)
  `)
  .eq('id', id)
  .eq('status', 'active')
  .single();

if (!product) return Astro.redirect('/');

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL as string;
const images      = [...(product.images ?? [])].sort((a, b) => a.display_order - b.display_order);
const primary     = images.find(i => i.is_primary) ?? images[0];
const imgUrl      = primary ? getImageUrl(supabaseUrl, primary.storage_path) : null;

const discount = product.compare_at_price
  ? Math.round((1 - product.price / product.compare_at_price) * 100)
  : null;

const specs = product.specifications as Record<string, string | number | boolean> | null;
---

<LayoutPublico
  title={product.name}
  description={product.short_description ?? product.name}
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">

    <!-- Breadcrumb -->
    <nav class="mb-8 flex items-center gap-2 text-sm text-slate-500" aria-label="Breadcrumb">
      <a href="/" class="hover:text-slate-200 transition-colors">Inicio</a>
      <span>/</span>
      {product.category && (
        <>
          <a
            href={`/?categoria=${product.category.slug}`}
            class="hover:text-slate-200 transition-colors"
          >
            {product.category.name}
          </a>
          <span>/</span>
        </>
      )}
      <span class="truncate text-slate-300">{product.name}</span>
    </nav>

    <!-- Layout principal: imagen + datos -->
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">

      <!-- Imagen principal -->
      <div class="glass-card overflow-hidden">
        <div class="aspect-[4/3]">
          {imgUrl ? (
            <img
              src={imgUrl}
              alt={primary?.alt_text ?? product.name}
              class="h-full w-full object-cover"
            />
          ) : (
            <div class="flex h-full items-center justify-center bg-slate-800">
              <svg class="h-24 w-24 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
          )}
        </div>
      </div>

      <!-- Datos del producto -->
      <div class="flex flex-col gap-5">

        <!-- Categoría + Marca -->
        <div class="flex flex-wrap items-center gap-2">
          {product.category && (
            <a
              href={`/?categoria=${product.category.slug}`}
              class="rounded-full border border-blue-700/40 bg-blue-900/30 px-3 py-1 text-xs font-medium text-blue-300 hover:bg-blue-900/50 transition-colors"
            >
              {product.category.name}
            </a>
          )}
          {product.brand && (
            <a
              href={`/?marca=${product.brand.slug}`}
              class="rounded-full bg-slate-800 px-3 py-1 text-xs font-medium text-slate-300 hover:bg-slate-700 transition-colors"
            >
              {product.brand.name}
            </a>
          )}
        </div>

        <!-- Nombre -->
        <h1 class="text-2xl font-bold text-white sm:text-3xl leading-tight">
          {product.name}
        </h1>

        <!-- Descripción corta -->
        {product.short_description && (
          <p class="text-slate-400">{product.short_description}</p>
        )}

        <!-- Precio y stock -->
        <div class="glass-card p-5">
          <div class="flex flex-wrap items-baseline gap-3">
            <span class="text-3xl font-bold text-white">
              ${product.price.toLocaleString('es-CO')}
            </span>
            {product.compare_at_price && (
              <span class="text-lg text-slate-500 line-through">
                ${product.compare_at_price.toLocaleString('es-CO')}
              </span>
            )}
            {discount && (
              <span class="rounded-md bg-red-600/20 px-2 py-0.5 text-sm font-bold text-red-400">
                -{discount}%
              </span>
            )}
          </div>

          <div class="mt-3 flex items-center gap-2">
            <div class={`h-2 w-2 rounded-full ${product.stock > 0 ? 'bg-emerald-400' : 'bg-red-500'}`} />
            <span class={`text-sm font-medium ${product.stock > 0 ? 'text-emerald-400' : 'text-red-400'}`}>
              {product.stock > 0
                ? `${product.stock} unidad${product.stock !== 1 ? 'es' : ''} disponible${product.stock !== 1 ? 's' : ''}`
                : 'Sin stock'}
            </span>
          </div>
        </div>

        <!-- Descripción completa -->
        {product.description && (
          <div>
            <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-400">
              Descripción
            </h3>
            <p class="text-sm leading-relaxed text-slate-400">{product.description}</p>
          </div>
        )}

        <!-- SKU -->
        {product.sku && (
          <p class="text-xs text-slate-600">SKU: {product.sku}</p>
        )}
      </div>
    </div>

    <!-- Especificaciones técnicas -->
    {specs && Object.keys(specs).length > 0 && (
      <div class="mt-14">
        <h2 class="mb-5 text-xl font-bold text-white">Especificaciones técnicas</h2>
        <div class="glass-card overflow-hidden">
          <table class="w-full">
            <tbody>
              {Object.entries(specs).map(([key, value], i) => (
                <tr class={`border-b border-white/5 last:border-0 ${i % 2 === 0 ? 'bg-slate-900/30' : ''}`}>
                  <td class="w-2/5 px-5 py-3 text-sm font-medium capitalize text-slate-400">
                    {key.replace(/_/g, ' ')}
                  </td>
                  <td class="px-5 py-3 text-sm text-slate-200">
                    {typeof value === 'boolean' ? (value ? 'Sí' : 'No') : String(value)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <!-- Volver -->
    <div class="mt-10">
      <a href="/" class="btn-secondary">← Volver al catálogo</a>
    </div>

  </div>
</PublicLayout>
